{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "placehold-us",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Apex + www are zone routes that attach the Worker in front of proxied DNS.
  // The Worker serves everything itself and 301s www to placehold.us
  // (src/routing.ts) so there is one site. (beta.placehold.us, a custom domain
  // used during the 2026 move off PHP, was retired 2026-11-03.)
  // The apex A record points at 192.0.2.1 (a reserved address nobody can own)
  // because there is no origin: the old PHP server was shut down 2026-10-26.
  // Removing these routes would take the site down, not roll it back.
  "routes": [
    { "pattern": "placehold.us/*", "zone_name": "placehold.us" },
    { "pattern": "www.placehold.us/*", "zone_name": "placehold.us" }
  ],
  // No workers.dev or preview URLs: the Cache API does nothing there, so they
  // would be an uncached copy of the site that renders every request.
  "workers_dev": false,
  "preview_urls": false,
  // wrangler dev presents requests as coming from the first route's host;
  // pin it to the main domain so local requests are never redirected.
  "dev": { "host": "placehold.us" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs first so it can redirect www; it hands non-image
    // paths (homepage, css, favicons, font, og image) to this binding.
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  // A render takes about 0.3s of CPU at most; cap runaway requests at 5s.
  "limits": { "cpu_ms": 5000 },
  "observability": {
    "enabled": true
  },
  // Bundle the .ttf font into the Worker as an ArrayBuffer (used by resvg for
  // raster rendering and by fontkit for SVG subsetting).
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "vars": {
    "GA_MEASUREMENT_ID": "G-73WR5GHTDB"
  },
  // Rate limits, checked only on cache misses so cached traffic is never
  // throttled. Keyed per IPv4 address or IPv6 /64 (src/routing.ts).
  "ratelimits": [
    {
      // all new images: 100 / minute (mirrors the old PHP limiter)
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      // raster images over 1 megapixel: 20 / minute
      "name": "RATE_LIMITER_LARGE",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
