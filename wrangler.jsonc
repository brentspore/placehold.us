{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "placehold-us",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // beta.* is a dedicated custom domain; apex + www are zone routes that attach
  // the Worker in front of proxied DNS. The Worker serves everything itself.
  // The apex A record points at 192.0.2.1 (a reserved address nobody can own)
  // because there is no origin: the old PHP server was shut down 2026-10-26.
  // Removing these routes would take the site down, not roll it back.
  "routes": [
    { "pattern": "beta.placehold.us", "custom_domain": true },
    { "pattern": "placehold.us/*", "zone_name": "placehold.us" },
    { "pattern": "www.placehold.us/*", "zone_name": "placehold.us" }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Static files (homepage, css, favicon, font) are served first when the
    // path matches a file in ./public; everything else falls through to the
    // Worker (the image generator). This replaces the old .htaccess routing.
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  // Bundle the .ttf font into the Worker as an ArrayBuffer (used by resvg for
  // raster rendering and by fontkit for SVG subsetting).
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "vars": {
    "GA_MEASUREMENT_ID": "G-73WR5GHTDB"
  },
  // Per-IP rate limiting (mirrors the old PHP limiter: 100 requests / 60s).
  // Checked only on cache misses, so cached traffic is never throttled.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 100, "period": 60 }
      }
    ]
  }
}
